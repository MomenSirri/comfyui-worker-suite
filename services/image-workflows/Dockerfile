 && test "$(stat -c %s /comfyui/models/LLM/GGUF/Qwen/Qwen3-VL-4B-Instruct-GGUF/Qwen3VL-4B-Instruct-Q8_0.gguf)" = "4280406144" \
 && test "$(stat -c %s /comfyui/models/LLM/GGUF/Qwen/Qwen3-VL-4B-Instruct-GGUF/mmproj-Qwen3VL-4B-Instruct-F16.gguf)" = "836180256"

# Pin QwenVL and its CUDA-compatible/Python 3.12 vision-enabled llama.cpp backend.
ARG QWENVL_COMMIT=517aed64fae294ca1a906d38e7bcf43ee54afa21
ARG QWENVL_LLAMA_CPP_VERSION=0.3.49
ARG QWENVL_LLAMA_CPP_WHEEL_URL=https://github.com/JamePeng/llama-cpp-python/releases/download/v0.3.49-cu128-linux-20260831/llama_cpp_python-0.3.49%2Bcu128-cp312-cp312-linux_x86_64.whl
ARG QWENVL_LLAMA_CPP_WHEEL_SHA256=17e8bfa1bf4f2f9988cdb68fc6d878719427365ff838f95f5c33c682c1b17fed
RUN set -eux; \
    rm -rf /comfyui/custom_nodes/ComfyUI-QwenVL; \
    mkdir -p /comfyui/custom_nodes/ComfyUI-QwenVL; \
    curl -fL --retry 5 --retry-delay 3 --retry-all-errors --connect-timeout 30 \
      "https://github.com/1038lab/ComfyUI-QwenVL/archive/${QWENVL_COMMIT}.tar.gz" \
      -o /tmp/comfyui-qwenvl.tar.gz; \
    tar -xzf /tmp/comfyui-qwenvl.tar.gz -C /comfyui/custom_nodes/ComfyUI-QwenVL --strip-components=1; \
    rm -f /tmp/comfyui-qwenvl.tar.gz; \
    /opt/venv/bin/python -m pip install --no-cache-dir \
      -r /comfyui/custom_nodes/ComfyUI-QwenVL/requirements.txt diskcache; \
    wheel="/tmp/$(basename "${QWENVL_LLAMA_CPP_WHEEL_URL}" | sed 's/%2[Bb]/+/g')"; \
    curl -fL --retry 5 --retry-delay 3 --retry-all-errors --connect-timeout 30 \
      "${QWENVL_LLAMA_CPP_WHEEL_URL}" -o "${wheel}"; \
    echo "${QWENVL_LLAMA_CPP_WHEEL_SHA256}  ${wheel}" | sha256sum -c -; \
    /opt/venv/bin/python -m pip install --no-cache-dir --no-deps "${wheel}"; \
    rm -f "${wheel}"; \
    /opt/venv/bin/python -c "import importlib.metadata as m; assert m.version('llama-cpp-python') == '${QWENVL_LLAMA_CPP_VERSION}'; from llama_cpp.llama_chat_format import Qwen3VLChatHandler, Qwen25VLChatHandler; print('QwenVL CUDA wheel installed:', m.version('llama-cpp-python'), Qwen3VLChatHandler.__name__, Qwen25VLChatHandler.__name__)"


