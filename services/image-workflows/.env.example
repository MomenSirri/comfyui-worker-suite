# Copy this file to ".env" and fill in your secrets.
# ".env" is already ignored by git.

# Model downloads / gated repos
HUGGINGFACE_ACCESS_TOKEN=
CIVITAI_API_TOKEN=

# Optional integrity check for Fluxmania Kreamania FP8 model
# Expected sha256 for:
# /comfyui/models/diffusion_models/fluxmania_kreamania.safetensors
KREAMANIA_FP8_SHA256=

# Optional runtime integrations
COMFY_ORG_API_KEY=
BUCKET_ENDPOINT_URL=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# Local dev defaults (used by docker-compose if you reference env vars)
SERVE_API_LOCALLY=true
